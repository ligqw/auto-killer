@echo off
chcp 65001 >nul
set "L=%~dp0optimization_log.txt"
(echo === ЛОГ - %DATE% %TIME% ===) > "%L%"
net session >nul 2>&1 || (echo [ОШИБКА] Запустите от АДМИНИСТРАТОРА! & echo [ОШИБКА] Нет прав >> "%L%" & pause & exit /b)
:MENU
cls & color 0B & title Оптимизация Pro & set "C="
echo ====================================
echo      УНИВЕРСАЛЬНАЯ ОПТИМИЗАЦИЯ      
echo ====================================
echo  1. Полная оптимизация (Все этапы)
echo  2. Выборочная оптимизация
echo  3. Проверка системы (SFC / DISM)
echo  4. Открыть лог (Журнал)
echo  5. Выход
echo ====================================
set /p C="Выбор (1-5): "
if "%C%"=="1" for /l %%i in (1,1,7) do set "o%%i=Y"
if "%C%"=="1" goto EX
if "%C%"=="2" goto CU
if "%C%"=="3" goto SYS
if "%C%"=="4" goto VL
if "%C%"=="5" exit /b
goto MENU
:CU
cls & echo Нажимайте Y (Да) или N (Нет). Пустой ввод = N.
echo ------------------------------------
for /l %%i in (1,1,7) do set "o%%i=N"
set /p o1="[1/7] Точка восстановления? (Y/N): "
set /p o2="[2/7] Очистка кэша и Temp? (Y/N): "
set /p o3="[3/7] Очистка DNS? (Y/N): "
set /p o4="[4/7] Питание и ядра CPU? (Y/N): "
set /p o5="[5/7] Отключить телеметрию? (Y/N): "
set /p o6="[6/7] Оптимизация ОЗУ? (Y/N): "
set /p o7="[7/7] Проверка SFC/DISM? (Y/N): "
:EX
cls & echo Выполнение этапов...
if /i "%o1%"=="Y" (
    echo [1/7] Точка восстановления... & echo СРВ >> "%L%"
    net start vss >nul 2>&1
    reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\SystemRestore" /v "SystemRestorePointCreationFrequency" /t REG_DWORD /d 0 /f >nul 2>&1
    powershell -NoProfile -Command "Enable-ComputerRestore -Drive 'C:\'; Checkpoint-Computer -Description 'BeforeOpt' -RestorePointType 'MODIFY_SETTINGS'" >nul 2>&1
)
if /i "%o2%"=="Y" (
    echo [2/7] Очистка Temp и кэша... & echo Очистка >> "%L%"
    del /f /q /s "%TEMP%\*" "%SystemRoot%\Temp\*" >nul 2>&1
    net stop wuauserv >nul 2>&1 & net stop bits >nul 2>&1 & timeout /t 2 /nobreak >nul
    del /f /q /s "%SystemRoot%\SoftwareDistribution\Download\*" >nul 2>&1
    net start bits >nul 2>&1 & net start wuauserv >nul 2>&1
)
if /i "%o3%"=="Y" (echo [3/7] Сброс DNS... & echo DNS >> "%L%" & ipconfig /flushdns >nul 2>&1)
if /i "%o4%"=="Y" (
    echo [4/7] Настройка питания... & echo Питание >> "%L%"
    powershell -NoProfile -Command "if(Get-CimInstance Win32_Battery){exit 1}" >nul 2>&1
    if errorlevel 1 (echo [ИНФО] Ноутбук. Пропущено. >> "%L%") else (
        powercfg /setactive 8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c >nul 2>&1
        powercfg /attributes 54533251-82bd-4e29-950d-4136c166a751 0cc5b647-c36e-417e-ba9d-d17442bc94de -ATTRIB_HIDE >nul 2>&1
        powercfg /setacvalueindex 8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c 54533251-82bd-4e29-950d-4136c166a751 0cc5b647-c36e-417e-ba9d-d17442bc94de 0 >nul 2>&1
        powercfg /setactive 8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c >nul 2>&1
    )
)
if /i "%o5%"=="Y" (
    echo [5/7] Отключение телеметрии... & echo Телеметрия >> "%L%"
    sc config DiagTrack start= disabled >nul 2>&1 & net stop DiagTrack >nul 2>&1
    sc config NvTelemetryContainer start= disabled >nul 2>&1 & net stop NvTelemetryContainer >nul 2>&1
    sc config AMDCrashDefenderService start= disabled >nul 2>&1 & net stop AMDCrashDefenderService >nul 2>&1
    reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\GameDVR" /v "AppCaptureEnabled" /t REG_DWORD /d 0 /f >nul 2>&1
    reg add "HKCU\System\GameConfigStore" /v "GameDVR_Enabled" /t REG_DWORD /d 0 /f >nul 2>&1
    reg add "HKLM\SOFTWARE\Microsoft\PolicyManager\default\ApplicationManagement\AllowGameDVR" /v "value" /t REG_DWORD /d 0 /f >nul 2>&1
    reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\GameDVR" /v "AllowGameDVR" /t REG_DWORD /d 0 /f >nul 2>&1
)
if /i "%o6%"=="Y" (
    echo [6/7] Оптимизация ОЗУ... & echo ОЗУ >> "%L%"
    taskkill /f /fi "status eq not responding" >nul 2>&1
    powershell -NoProfile -EncodedCommand "" >nul 2>&1
)
if /i "%o7%"=="Y" goto SYSE
goto FI
:SYS
cls & echo ==================================== & echo        ПРОВЕРКА SFC / DISM        & echo ====================================
:SYSE
echo [7/7] Запуск DISM и SFC... & echo DISM/SFC >> "%L%"
dism /online /cleanup-image /scanhealth >> "%L%" 2>&1
dism /online /cleanup-image /restorehealth >> "%L%" 2>&1
sfc /scannow >> "%L%" 2>&1
if "%C%"=="3" pause & goto MENU
:FI
echo ====================================
echo  Готово! Лог сохранен в файл.
echo  Рекомендуется перезагрузка.
echo ====================================
echo [КОНЕЦ] Успешно >> "%L%" & pause & goto MENU
:VL
if exist "%L%" (start "" "%L%") else (echo Нет лога. & pause)
goto MENU

