@echo off
setlocal enabledelayedexpansion
chcp 65001 >nul & set "L=%~dp0optimization_log.txt"

:: Initialize log file in UTF-16LE with BOM
powershell -NoProfile -Command "'' | Out-File -FilePath \"%L%\" -Encoding Unicode"
cmd /u /c echo === LOG - %DATE% %TIME% === >> "%L%"

:: Administrator rights check
net session >nul 2>&1
if errorlevel 1 (
    echo [ERROR] Run as ADMINISTRATOR!
    cmd /u /c echo No rights >> "%L%"
    pause
    endlocal & exit
)

:MENU
mode con: cols=60 lines=22
cls & color 0B & title Optimization Pro & set "C="
echo.
echo.
echo.
echo         ┌────────────────────────────────────────┐
echo         │       UNIVERSAL OPTIMIZATION           │
echo         ├────────────────────────────────────────┤
echo         │                                        │
echo         │  1. Full optimization (All steps)     │
echo         │                                        │
echo         │  2. Selective optimization             │
echo         │                                        │
echo         │  3. System check (SFC / DISM)          │
echo         │                                        │
echo         │  4. Open log (Journal)                 │
echo         │                                        │
echo         │  5. Exit                               │
echo         │                                        │
echo         └────────────────────────────────────────┘
echo.
set /p C="  Choice (1-5): "
if "%C%"=="1" (
    for /l %%i in (1,1,7) do set "o%%i=Y"
    goto EX
)
if "%C%"=="2" goto CU
if "%C%"=="3" goto SYS
if "%C%"=="4" goto VL
if "%C%"=="5" endlocal & exit /b
goto MENU

:CU
cls & echo ┌────────────────────────────────────────┐ & echo │        SELECTIVE SETUP                 │ & echo └────────────────────────────────────────┘ & echo * Enter Y/N. Empty Enter = N & echo ──────────────────────────────────────────
for /l %%i in (1,1,7) do set "o%%i=N"
set "in=" & set /p in=" [1/7] Restore point? (Y/N): " & if /i "!in!"=="Y" set "o1=Y"
set "in=" & set /p in=" [2/7] Clear cache and Temp?  (Y/N): " & if /i "!in!"=="Y" set "o2=Y"
set "in=" & set /p in=" [3/7] Clear DNS?              (Y/N): " & if /i "!in!"=="Y" set "o3=Y"
set "in=" & set /p in=" [4/7] Power and CPU cores?    (Y/N): " & if /i "!in!"=="Y" set "o4=Y"
set "in=" & set /p in=" [5/7] Disable telemetry?      (Y/N): " & if /i "!in!"=="Y" set "o5=Y"
set "in=" & set /p in=" [6/7] RAM optimization?       (Y/N): " & if /i "!in!"=="Y" set "o6=Y"
set "in=" & set /p in=" [7/7] Check SFC/DISM?         (Y/N): " & if /i "!in!"=="Y" set "o7=Y"
goto EX

:EX
mode con: cols=60 lines=22
cls & color 0B
echo.
echo.
echo.
echo         ┌────────────────────────────────────────┐
echo         │         OPTIMIZATION EXECUTION         │
echo         └────────────────────────────────────────┘
echo.

if /i "%o1%"=="Y" (
    echo   [+] Restore point... & cmd /u /c echo  System Restore >> "%L%"
    net start VSS >nul 2>&1
    reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\SystemRestore" /v "SystemRestorePointCreationFrequency" /t REG_DWORD /d 0 /f >nul 2>&1
    powershell -NoProfile -Command "Enable-ComputerRestore -Drive 'C:\'; Checkpoint-Computer -Description 'BeforeOpt' -RestorePointType 'MODIFY_SETTINGS'" >nul 2>&1
)

if /i "%o2%"=="Y" (
    echo   [+] Clearing Temp and cache... & cmd /u /c echo  Cleanup >> "%L%"
    del /f /q /s "%TEMP%\*" "%SystemRoot%\Temp\*" >nul 2>&1
    for /d %%p in ("%TEMP%\*" "%SystemRoot%\Temp\*") do rmdir /s /q "%%p" >nul 2>&1
    net stop wuauserv >nul 2>&1 & net stop bits >nul 2>&1 & timeout /t 2 /nobreak >nul
    del /f /q /s "%SystemRoot%\SoftwareDistribution\Download\*" >nul 2>&1
    for /d %%p in ("%SystemRoot%\SoftwareDistribution\Download\*") do rmdir /s /q "%%p" >nul 2>&1
    net start bits >nul 2>&1 & net start wuauserv >nul 2>&1
)

if /i "%o3%"=="Y" echo   [+] DNS flush... & cmd /u /c echo  DNS >> "%L%" & ipconfig /flushdns >nul 2>&1

if /i "%o4%"=="Y" (
    echo   [+] Power settings... & cmd /u /c echo  Power >> "%L%"
    powershell -NoProfile -Command "if (Get-CimInstance Win32_Battery) { exit 1 }" >nul 2>&1
    if errorlevel 1 (
        cmd /u /c echo [INFO] Laptop >> "%L%"
        echo       └─ [INFO] Laptop. Skipped.
    ) else (
        powercfg /setactive 8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c >nul 2>&1
        powercfg /attributes 54533251-82bd-4e29-950d-4136c166a751 0cc5b647-c36e-417e-ba9d-d17442bc94de -ATTRIB_HIDE >nul 2>&1
        powercfg /setacvalueindex 8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c 54533251-82bd-4e29-950d-4136c166a751 0cc5b647-c36e-417e-ba9d-d17442bc94de 0 >nul 2>&1
        powercfg /setactive 8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c >nul 2>&1
    )
)

if /i "%o5%"=="Y" (
    echo   [+] Disabling telemetry... & cmd /u /c echo  Telemetry >> "%L%"
    sc config DiagTrack start= disabled >nul 2>&1 & net stop DiagTrack >nul 2>&1
    sc config NvTelemetryContainer start= disabled >nul 2>&1 & net stop NvTelemetryContainer >nul 2>&1
    sc config AMDCrashDefenderService start= disabled >nul 2>&1 & net stop AMDCrashDefenderService >nul 2>&1
    reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\GameDVR" /v "AppCaptureEnabled" /t REG_DWORD /d 0 /f >nul 2>&1
    reg add "HKCU\System\GameConfigStore" /v "GameDVR_Enabled" /t REG_DWORD /d 0 /f >nul 2>&1
    reg add "HKLM\SOFTWARE\Microsoft\PolicyManager\default\ApplicationManagement\AllowGameDVR" /v "value" /t REG_DWORD /d 0 /f >nul 2>&1
    reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\GameDVR" /v "AllowGameDVR" /t REG_DWORD /d 0 /f >nul 2>&1
)

if /i "%o6%"=="Y" (
    echo   [+] RAM optimization... & cmd /u /c echo  RAM >> "%L%"
    taskkill /f /fi "status eq not responding" >nul 2>&1
    powershell -NoProfile -EncodedCommand "" >nul 2>&1
)

if /i "%o7%"=="Y" goto SYSE
goto FI

:SYS
mode con: cols=60 lines=22
cls & color 0B
echo.
echo.
echo.
echo         ┌────────────────────────────────────────┐
echo         │          SFC / DISM CHECK              │
echo         └────────────────────────────────────────┘
:SYSE
echo.
echo   [+] Starting system scan...
echo   [!] Step may take up to 15-20 minutes.
cmd /u /c echo  DISM/SFC >> "%L%"

dism /online /cleanup-image /scanhealth > "%TEMP%\d1.tmp" 2>&1
powershell -NoProfile -Command "Get-Content '%TEMP%\d1.tmp' -ErrorAction SilentlyContinue | Out-File \"%L%\" -Append -Encoding Unicode"

dism /online /cleanup-image /restorehealth > "%TEMP%\d2.tmp" 2>&1
powershell -NoProfile -Command "Get-Content '%TEMP%\d2.tmp' -ErrorAction SilentlyContinue | Out-File \"%L%\" -Append -Encoding Unicode"

sfc /scannow > "%TEMP%\s1.tmp" 2>&1
powershell -NoProfile -Command "Get-Content '%TEMP%\s1.tmp' -ErrorAction SilentlyContinue | Out-File \"%L%\" -Append -Encoding Unicode"

del /f /q "%TEMP%\d1.tmp" "%TEMP%\d2.tmp" "%TEMP%\s1.tmp" >nul 2>&1

if "%C%"=="3" (
    echo.
    echo   [SUCCESS] Scan completed.
    pause & goto MENU
) else (
    goto FI
)

:FI
mode con: cols=60 lines=22
cls & color 0B
echo.
echo.
echo.
echo         ┌────────────────────────────────────────┐
echo         │         OPTIMIZATION COMPLETED!         │
echo         ├────────────────────────────────────────┤
echo         │  * All details saved to log.           │
echo         │  * It is recommended to restart the PC.│
echo         └────────────────────────────────────────┘
echo.
cmd /u /c echo [END] Success >> "%L%"
pause & goto MENU

:VL
if exist "%L%" (start "" "%L%") else (echo  [!] Log file not yet created. & pause)
goto MENU
